# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://locana:locana@localhost:5432/locana?schema=public
# Leave empty to use the in-process rate limiter and event bus (single instance only).
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Optional: Google Sign-In (OAuth "Web application" client ID used by the Android app as serverClientId)
GOOGLE_CLIENT_ID=
# Optional: SMTP for password-reset e-mails. If empty in development, reset codes are logged (never in production).
SMTP_URL=
MAIL_FROM="Locana <no-reply@example.com>"
# Location retention (days) for optional location history
LOCATION_HISTORY_RETENTION_DAYS=30
# Comma separated user ids allowed to use /v1/admin routes
ADMIN_USER_IDS=
# Game day boundaries (minutes east of UTC). 420 = WIB.
GAME_TZ_OFFSET_MINUTES=420
# docker-compose only
POSTGRES_USER=locana
POSTGRES_PASSWORD=change-me
# Comma separated CORS origins for the admin/web tools (mobile clients do not need CORS)
CORS_ORIGINS=
