{
  "name": "locana-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Locana backend: auth, circles, live location, places and the real-world game engine",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "ts-node src/scripts/seed.ts",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand",
    "test:all": "jest --config jest.config.js --runInBand"
  },
  "prisma": {
    "seed": "ts-node src/scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-ws": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "google-auth-library": "9.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "6.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.2",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.6"
  }
}
