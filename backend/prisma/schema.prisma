// Locana data model.
//
// Conventions:
// - IDs are UUIDs generated by the database.
// - Coordinates are stored only in LatestLocation, LocationHistory, SavedPlace,
//   Landmark and Territory. Feeds, notifications and game events never copy them.
// - Secrets (passwords, refresh tokens, reset codes, invitation codes) are stored as hashes.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  passwordHash String?
  googleSub    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile            UserProfile?
  privacy            UserPrivacySettings?
  sessions           UserSession[]
  resetTokens        PasswordResetToken[]
  memberships        CircleMembership[]
  invitationsCreated CircleInvitation[]       @relation("InvitationCreator")
  sharingSessions    LocationSharingSession[]
  latestLocation     LatestLocation?
  locationHistory    LocationHistory[]
  placesCreated      SavedPlace[]
  geofenceStates     GeofenceState[]
  geofenceEvents     GeofenceEvent[]
  quests             UserQuest[]
  questCompletions   QuestCompletion[]
  xpTransactions     XPTransaction[]
  achievements       UserAchievement[]
  collectibles       UserCollectible[]
  tileDiscoveries    TileDiscovery[]
  landmarkVisits     LandmarkVisit[]
  territoryEvents    TerritoryEvent[]
  notifications      Notification[]
  devices            DeviceRegistration[]
  feedItems          ActivityFeedItem[]
  reactions          FeedReaction[]
  blocksMade         UserBlock[]              @relation("Blocker")
  blocksReceived     UserBlock[]              @relation("Blocked")
  hiddenFrom         MemberVisibility[]       @relation("VisibilityOwner")
  hiddenFor          MemberVisibility[]       @relation("VisibilityViewer")
  reportsMade        AbuseReport[]            @relation("Reporter")
  reportsReceived    AbuseReport[]            @relation("Reported")
  dailyStats         DailyActivityStat[]
  riskSignals        RiskSignal[]
}

model UserProfile {
  userId          String    @id @db.Uuid
  displayName     String
  avatarKey       String    @default("explorer_teal")
  avatarFrameKey  String?
  titleKey        String?
  markerKey       String?
  bio             String?   @db.VarChar(160)
  level           Int       @default(1)
  xp              Int       @default(0) // XP inside the current level is derived; this is total XP
  lifetimeXp      Int       @default(0)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveDay   DateTime? @db.Date
  totalDistanceM  Float     @default(0)
  tilesDiscovered Int       @default(0)
  questsCompleted Int       @default(0)
  onboardingDone  Boolean   @default(false)
  // Circle that receives this player's territory points. Chosen by the player, never inferred.
  teamCircleId    String?   @db.Uuid
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid // all rotated refresh tokens of one login share a family
  refreshTokenHash String    @unique
  deviceName       String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceRegistration {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  installId  String
  platform   String   @default("android")
  model      String?
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installId])
}

model UserPrivacySettings {
  userId                  String   @id @db.Uuid
  // Location sharing is never enabled implicitly. Each circle also needs an active sharing session.
  sharingPaused           Boolean  @default(false)
  historyEnabled          Boolean  @default(false)
  historyRetentionDays    Int      @default(7)
  explorationEnabled      Boolean  @default(false) // game processing of own location samples
  showInLeaderboards      Boolean  @default(true)
  leaderboardAlias        String?
  shareExplorationWithCircles Boolean @default(true) // aggregated stats only, never tiles/coordinates
  notifyArrivals          Boolean  @default(true)
  notifyQuests            Boolean  @default(true)
  notifyAchievements      Boolean  @default(true)
  notifyCircle            Boolean  @default(true)
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model AbuseReport {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @db.Uuid
  reportedId String   @db.Uuid
  circleId   String?  @db.Uuid
  reason     String
  details    String?  @db.VarChar(1000)
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Circles ─────────────────────────────

enum CircleRole {
  OWNER
  ADMIN
  MEMBER
}

model Circle {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  avatarKey   String             @default("circle_compass")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships CircleMembership[]
  invitations CircleInvitation[]
  sharing     LocationSharingSession[]
  places      SavedPlace[]
  feedItems   ActivityFeedItem[]
  territories Territory[]        @relation("TerritoryOwnerCircle")
  territoryEvents TerritoryEvent[]
  challenges  CircleChallenge[]
  visibility  MemberVisibility[]
}

model CircleMembership {
  id        String     @id @default(uuid()) @db.Uuid
  circleId  String     @db.Uuid
  userId    String     @db.Uuid
  role      CircleRole @default(MEMBER)
  muted     Boolean    @default(false)
  joinedAt  DateTime   @default(now())
  circle    Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

/// Per-member visibility: owner hides their location from a specific viewer in a circle.
model MemberVisibility {
  circleId String @db.Uuid
  ownerId  String @db.Uuid
  viewerId String @db.Uuid
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  owner    User   @relation("VisibilityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer   User   @relation("VisibilityViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([circleId, ownerId, viewerId])
}

model CircleInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  circleId    String    @db.Uuid
  createdById String    @db.Uuid
  codeHash    String    @unique
  codeHint    String    // last 2 characters, for the management list
  maxUses     Int       @default(10)
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  circle      Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([circleId])
}

// ───────────────────────────── Location ─────────────────────────────

enum SharingStatus {
  ACTIVE
  PAUSED
  ENDED
}

model LocationSharingSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  circleId  String        @db.Uuid
  status    SharingStatus @default(ACTIVE)
  startedAt DateTime      @default(now())
  expiresAt DateTime?     // null = until stopped
  pausedAt  DateTime?
  endedAt   DateTime?
  endReason String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle    Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([userId, circleId, status])
  @@index([status, expiresAt])
}

model LatestLocation {
  userId     String   @id @db.Uuid
  latitude   Float
  longitude  Float
  accuracyM  Float
  speedMps   Float?
  bearingDeg Float?
  altitudeM  Float?
  source     String
  activity   String?
  sessionId  String?
  sequence   BigInt
  recordedAt DateTime
  receivedAt DateTime @default(now())
  batteryPct Int?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  latitude   Float
  longitude  Float
  accuracyM  Float
  speedMps   Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([createdAt])
}

enum PlaceType {
  HOME
  WORK
  SCHOOL
  CUSTOM
}

model SavedPlace {
  id          String          @id @default(uuid()) @db.Uuid
  circleId    String          @db.Uuid
  createdById String          @db.Uuid
  name        String
  type        PlaceType       @default(CUSTOM)
  latitude    Float
  longitude   Float
  radiusM     Int             @default(150)
  notifyArrive Boolean        @default(true)
  notifyLeave  Boolean        @default(true)
  // Member IDs who receive arrival/departure notifications; empty = all members (respecting mute).
  notifyUserIds String[]      @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  circle      Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  states      GeofenceState[]
  events      GeofenceEvent[]

  @@index([circleId])
}

model GeofenceState {
  userId      String     @db.Uuid
  placeId     String     @db.Uuid
  inside      Boolean
  pendingInside Boolean? // candidate transition waiting for a confirming sample
  pendingSince DateTime?
  changedAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       SavedPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
}

enum GeofenceEventType {
  ARRIVE
  LEAVE
}

model GeofenceEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  placeId   String            @db.Uuid
  type      GeofenceEventType
  occurredAt DateTime
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     SavedPlace        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([userId, placeId, occurredAt])
}

// ───────────────────────────── Game ─────────────────────────────

/// Configurable XP curve. totalXp = minimum lifetime XP to reach `level`.
model LevelThreshold {
  level   Int    @id
  totalXp Int    @unique
  rewardCollectibleCode String?
}

enum QuestType {
  DAILY
  WEEKLY
  SPECIAL
}

/// Reusable quest conditions evaluated by the quest engine.
enum QuestCondition {
  DISCOVER_TILES      // discover N new map tiles
  VISIT_LANDMARKS     // validated visits to N distinct landmarks (params.landmarkIds optional)
  WALK_DISTANCE       // move N metres at walking-plausible speed
  CIRCLE_TILES        // circle members together discover N tiles (group objective)
  ACTIVE_DAYS         // active (validated movement) on N distinct days in the period
  COLLECT_LANDMARK_SET // visit every landmark of a set (params.setCode)
}

model QuestDefinition {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  description   String
  type          QuestType
  condition     QuestCondition
  target        Int
  params        Json           @default("{}")
  rewardXp      Int
  rewardCollectibleCode String?
  minLevel      Int            @default(1)
  startsAt      DateTime?
  endsAt        DateTime?
  maxCompletionsPerPeriod Int  @default(1)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  userQuests    UserQuest[]
  completions   QuestCompletion[]
}

enum UserQuestStatus {
  ACTIVE
  COMPLETED
  CLAIMED
  EXPIRED
}

/// One row per user, quest and period (e.g. 2026-10-28 for daily, 2026-W44 for weekly).
model UserQuest {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  questId     String          @db.Uuid
  periodKey   String
  status      UserQuestStatus @default(ACTIVE)
  progress    Int             @default(0)
  // Distinct keys already counted (tile ids, landmark ids, day keys) so repeated samples never count twice.
  progressKeys String[]
  circleId    String?         @db.Uuid
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  claimedAt   DateTime?
  expiresAt   DateTime
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)
  progressLog QuestProgress[]
  completion  QuestCompletion?

  @@unique([userId, questId, periodKey])
  @@index([userId, status])
}

model QuestProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userQuestId String    @db.Uuid
  delta       Int
  reason      String
  createdAt   DateTime  @default(now())
  userQuest   UserQuest @relation(fields: [userQuestId], references: [id], onDelete: Cascade)

  @@index([userQuestId])
}

model QuestCompletion {
  id             String          @id @default(uuid()) @db.Uuid
  userQuestId    String          @unique @db.Uuid
  userId         String          @db.Uuid
  questId        String          @db.Uuid
  idempotencyKey String          @unique
  xpAwarded      Int
  claimedAt      DateTime        @default(now())
  userQuest      UserQuest       @relation(fields: [userQuestId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest          QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId, claimedAt])
}

enum XpSource {
  QUEST
  TILE_DISCOVERY
  LANDMARK
  ACHIEVEMENT
  TERRITORY
  STREAK
  ADMIN
}

/// Append-only ledger. (source, sourceRef) is unique per user, so the same reward can never be granted twice.
model XPTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  amount    Int
  source    XpSource
  sourceRef String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([createdAt])
  @@index([userId, createdAt])
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model AchievementDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String
  rarity      Rarity
  iconKey     String
  // { "metric": "tilesDiscovered" | "landmarksVisited" | "questsCompleted" | "level" | "streak" | "weekendTiles" | "circleQuests" | "territoriesClaimed", "gte": n }
  criteria    Json
  rewardXp    Int      @default(0)
  rewardCollectibleCode String?
  sortOrder   Int      @default(0)
  users       UserAchievement[]
}

model UserAchievement {
  userId        String                @db.Uuid
  achievementId String                @db.Uuid
  unlockedAt    DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

enum CollectibleKind {
  BADGE
  AVATAR_FRAME
  TITLE
  MAP_MARKER
  LANDMARK_STAMP
}

model CollectibleDefinition {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  description String
  kind        CollectibleKind
  rarity      Rarity
  setCode     String?
  iconKey     String
  users       UserCollectible[]
}

model UserCollectible {
  userId        String                @db.Uuid
  collectibleId String                @db.Uuid
  acquiredAt    DateTime              @default(now())
  source        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible   CollectibleDefinition @relation(fields: [collectibleId], references: [id], onDelete: Cascade)

  @@id([userId, collectibleId])
}

/// Exploration grid cell (Web-Mercator slippy tile "z/x/y"). Created lazily on first discovery.
model MapTile {
  id          String          @id // "17/104512/67521"
  zoom        Int
  x           Int
  y           Int
  firstSeenAt DateTime        @default(now())
  discoveries TileDiscovery[]
}

model TileDiscovery {
  userId       String   @db.Uuid
  tileId       String
  discoveredAt DateTime @default(now())
  visits       Int      @default(1)
  lastVisitAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tile         MapTile  @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@id([userId, tileId])
  @@index([userId, discoveredAt])
}

/// Public discovery point (park, museum, monument…). Only public places, never private homes.
model Landmark {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String
  category    String
  latitude    Float
  longitude   Float
  radiusM     Int      @default(80)
  setCode     String?
  collectibleCode String?
  rewardXp    Int      @default(50)
  active      Boolean  @default(true)
  visits      LandmarkVisit[]
  territory   Territory?

  @@index([latitude, longitude])
}

model LandmarkVisit {
  userId     String   @db.Uuid
  landmarkId String   @db.Uuid
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())
  count      Int      @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  landmark   Landmark @relation(fields: [landmarkId], references: [id], onDelete: Cascade)

  @@id([userId, landmarkId])
}

/// Friendly territory around a public landmark. Ownership is a game state only.
model Territory {
  id             String    @id @default(uuid()) @db.Uuid
  landmarkId     String    @unique @db.Uuid
  name           String
  ownerCircleId  String?   @db.Uuid
  ownerScore     Int       @default(0)
  claimedAt      DateTime?
  expiresAt      DateTime?
  totalVisits    Int       @default(0)
  updatedAt      DateTime  @updatedAt
  version        Int       @default(0)
  landmark       Landmark  @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  ownerCircle    Circle?   @relation("TerritoryOwnerCircle", fields: [ownerCircleId], references: [id], onDelete: SetNull)
  events         TerritoryEvent[]
  scores         TerritoryScore[]
}

/// Aggregated activity score per circle and event period. No timestamps of individual members are exposed.
model TerritoryScore {
  territoryId String    @db.Uuid
  circleId    String    @db.Uuid
  periodKey   String
  score       Int       @default(0)
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@id([territoryId, circleId, periodKey])
  @@index([periodKey, score])
}

model TerritoryEvent {
  id          String    @id @default(uuid()) @db.Uuid
  territoryId String    @db.Uuid
  circleId    String?   @db.Uuid
  userId      String?   @db.Uuid
  type        String    // VISIT | CLAIM | DECAY | DEFEND
  points      Int       @default(0)
  createdAt   DateTime  @default(now())
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  circle      Circle?   @relation(fields: [circleId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([territoryId, createdAt])
}

/// Scheduled seasonal/territory events.
model GameEvent {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  description String
  kind      String   // TERRITORY_SEASON | COLLECTIBLE_HUNT | EXPLORATION_SEASON
  startsAt  DateTime
  endsAt    DateTime
  config    Json     @default("{}")
}

model CircleChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  circleId  String   @db.Uuid
  createdById String @db.Uuid
  title     String
  metric    String   // TILES | LANDMARKS | QUESTS
  target    Int
  startsAt  DateTime @default(now())
  endsAt    DateTime
  progress  Int      @default(0)
  completedAt DateTime?
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, endsAt])
}

model DailyActivityStat {
  userId       String   @db.Uuid
  day          DateTime @db.Date
  distanceM    Float    @default(0)
  tiles        Int      @default(0)
  landmarks    Int      @default(0)
  xp           Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model LeaderboardSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  board     String   // WEEKLY_XP | SEASON_XP | EXPLORATION | QUESTS
  periodKey String
  scopeId   String?  // circle id for circle boards, null for global/season
  userId    String   @db.Uuid
  alias     String
  rank      Int
  score     Int
  createdAt DateTime @default(now())

  @@unique([board, periodKey, scopeId, userId])
  @@index([board, periodKey, rank])
}

/// Probabilistic anti-cheat signals. They reduce rewards for a sample but never ban automatically.
model RiskSignal {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  kind      String   // IMPOSSIBLE_SPEED | CLOCK_SKEW | LOW_ACCURACY | REPLAY | MOCK_PROVIDER
  weight    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────────── Social / notifications ─────────────────────────────

model ActivityFeedItem {
  id        String   @id @default(uuid()) @db.Uuid
  circleId  String   @db.Uuid
  actorId   String   @db.Uuid
  kind      String   // ACHIEVEMENT | LEVEL_UP | QUEST | JOINED | TERRITORY | CHALLENGE | ARRIVE | LEAVE
  // Display data only (names/codes). Never coordinates.
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  reactions FeedReaction[]

  @@index([circleId, createdAt])
}

model FeedReaction {
  feedItemId String           @db.Uuid
  userId     String           @db.Uuid
  emoji      String
  createdAt  DateTime         @default(now())
  feedItem   ActivityFeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([feedItemId, userId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  targetType String?
  targetId  String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model IdempotencyRecord {
  key       String   @id
  userId    String   @db.Uuid
  response  Json
  createdAt DateTime @default(now())
}
